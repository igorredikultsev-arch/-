# База данных PostgreSQL (сервер в РФ)
DATABASE_URL="postgresql://avtoslot:avtoslot@localhost:5432/avtoslot"

# Основной домен сервиса. Сайты клиентов: <slug>.ROOT_DOMAIN
ROOT_DOMAIN="avtoslot.local"
# Публичный адрес кабинета и админки
APP_URL="http://localhost:3000"

# Яндекс SmartCaptcha. Если ключи пустые, капча отключена (только для разработки)
SMARTCAPTCHA_CLIENT_KEY=""
SMARTCAPTCHA_SERVER_KEY=""

# Секрет для служебных задач (очистка демо по расписанию)
CRON_SECRET="change-me"

# Реквизиты обработчика персональных данных (вы, как владелец сервиса) — попадают в согласие и политику
PROCESSOR_NAME="Фамилия Имя Отчество, самозанятый"
PROCESSOR_INN=""
PROCESSOR_EMAIL="" # только российская почта (Яндекс, Mail.ru): ч. 5 ст. 18 152-ФЗ

# Где стоит сервер с базой: город и хостинг-провайдер. Попадает в черновики уведомлений клиентов в Роскомнадзор
DB_LOCATION=""
# Хостинг-провайдер для списка подрядчиков в оферте и политике: название и ИНН из договора, например «ООО «Название», ИНН 0000000000»
HOSTING_PROVIDER=""

# Главная страница avtoslot.ru (необязательно): ваш Telegram без @ и slug демо, которое показывать как пример
CONTACT_TELEGRAM=""
EXAMPLE_SLUG=""

# ---- Только для сервера (docker compose) ----
POSTGRES_PASSWORD=""
# Почта для Let's Encrypt
ACME_EMAIL=""
# Резервные копии в S3-хранилище в России у другой компании, не там, где сервер (README: «Копии и мониторинг»)
S3_BUCKET=""
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Мониторинг Healthchecks (необязательно): адрес проверки «сайт жив» (раз в 5 минут) и «ночная копия сделана».
# После изменения: ./deploy/schedule.sh
HEALTHCHECK_URL=""
HEALTHCHECK_BACKUP_URL=""
