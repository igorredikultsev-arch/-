// Схема данных «Автослот». Раздел 5.4 плана.
// Все моменты времени хранятся в UTC. Часы работы и даты исключений — в местном времени сервиса.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  demo
  trial
  active
  suspended
  archived
}

enum Theme {
  tire // «Боковина»
  plan // «План»
  taxi // «Такси»
}

enum BookingSource {
  site
  owner
}

enum BookingStatus {
  active
  cancelled
  no_show
  done
}

enum BlockScope {
  all
  one_post
}

enum Role {
  owner
  admin
}

enum LeadStatus {
  new
  asked // спросили, можно ли прислать демо (ст. 15 152-ФЗ), ждём ответа
  demo_sent
  replied
  interested
  trial
  paid
  refused
}

model Business {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  city     String @default("Пермь")
  timezone String @default("Asia/Yekaterinburg")

  address        String
  addressNote    String?
  phone          String
  yandexMapsUrl  String?
  twoGisUrl      String?
  rating         Decimal? @db.Decimal(2, 1)
  reviewsYandex  Int?
  reviews2gis    Int?

  headline    String?
  facts       Json? // [{ value: "2 поста", label: "можно приехать вдвоём" }]
  theme         Theme     @default(taxi)
  accent        String    @default("#1f9d55")
  themeChosenAt DateTime? // владелец сам выбрал стиль в демо
  // Логотип загружает владелец в кабинете; сама картинка — в BusinessLogo, здесь время загрузки для адреса без кеша
  logoAt      DateTime?

  // Настройки расписания (раздел 4.1)
  posts        Int @default(1)
  /// Сколько постов отдано под запись с сайта (остальные — живая очередь и звонки, их в кабинет вносить не нужно)
  onlinePosts  Int @default(1)
  slotStepMin  Int @default(30)
  minLeadMin   Int @default(120)
  horizonDays  Int @default(14)
  cancelHours  Int @default(0) // за сколько часов до визита клиент ещё может отменить онлайн; 0 — до начала

  // Оператор персональных данных — сам автосервис (раздел 6.3)
  operatorName String?
  operatorInn  String?
  // Уведомление сервиса в Роскомнадзор об обработке данных клиентов: когда подано и номер (отмечает администратор)
  rknFiledAt   DateTime?
  rknNumber    String?
  // Принятие оферты владельцем в кабинете (галочка при первом входе): когда и какая редакция
  offerAcceptedAt DateTime?
  offerVersion    String?
  // Утренняя сводка владельцу (push в 8:00 по времени сервиса): можно выключить в кабинете.
  // digestSentOn — местная дата последней сводки, чтобы при повторном запуске расписания не прислать вторую
  digestEnabled Boolean @default(true)
  digestSentOn  String?

  status         BusinessStatus @default(demo)
  demoExpiresAt  DateTime?
  trialEndsAt    DateTime?
  paidUntil      DateTime?
  // Когда сайт приостановили (нет оплаты или вручную). Через 60 дней приостановки договор расторгнут (оферта, п. 4.2),
  // и в админке появляется напоминание удалить данные (п. 7.7). При возобновлении стирается
  suspendedAt    DateTime?
  customDomain   String?        @unique
  addonTelegram  Boolean        @default(false)
  addonSms       Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services     Service[]
  hours        WorkingHours[]
  exceptions   DayException[]
  bookings     Booking[]
  blocks       Block[]
  users        User[]
  lead         Lead?
  payments     Payment[]
  pushSubs     PushSubscription[]
  logo         BusinessLogo?
}

/// Картинка логотипа отдельно от Business: сервис читается на каждой странице, а картинка нужна только сайту.
/// Хранится в базе, поэтому попадает в резервные копии вместе со всем остальным.
model BusinessLogo {
  businessId String   @id
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  data       Bytes
  mime       String
  updatedAt  DateTime @updatedAt
}

model Service {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     String
  name         String
  description  String?
  priceFrom    Int
  durationMin  Int
  isDiagnostic Boolean  @default(false)
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  bookings     Booking[]

  @@index([businessId, sortOrder])
}

/// Часы работы по дню недели: 1 — понедельник … 7 — воскресенье. Минуты от полуночи по местному времени.
model WorkingHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday    Int
  closed     Boolean  @default(false)
  openMin    Int      @default(540)
  closeMin   Int      @default(1200)
  // Обед или другой ежедневный перерыв (минуты от полуночи). Пусто — без перерыва
  breakFromMin Int?
  breakToMin   Int?

  @@unique([businessId, weekday])
}

/// Особый день: праздник или изменённые часы. date — «YYYY-MM-DD» по местному времени.
model DayException {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       String
  closed     Boolean  @default(true)
  openMin    Int?
  closeMin   Int?

  @@unique([businessId, date])
}

model Booking {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName String
  priceFrom   Int?
  startAt     DateTime
  endAt       DateTime
  source      BookingSource
  status      BookingStatus @default(active)

  clientName  String?
  clientPhone String?
  car         String?
  comment     String?

  cancelToken String @unique

  // Согласие на обработку ПДн (раздел 6.3, п. 2) и отдельное согласие на рекламу (раздел 6.6)
  consentVersion   String?
  consentAt        DateTime?
  consentIp        String?
  marketingConsent Boolean   @default(false)

  createdAt   DateTime  @default(now())
  cancelledAt DateTime?
  cancelledBy String?

  @@index([businessId, startAt])
  @@index([businessId, status, startAt])
  // Удаление услуги обнуляет serviceId у её записей: без индекса это просмотр всех записей всех сервисов
  @@index([serviceId])
}

model Block {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  startAt    DateTime
  endAt      DateTime
  scope      BlockScope @default(all)
  reason     String?
  createdAt  DateTime   @default(now())

  @@index([businessId, startAt])
}

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  passwordHash String
  role         Role      @default(owner)
  name         String?
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
  pushSubs     PushSubscription[]
}

/// Подписка телефона или компьютера владельца на уведомления кабинета (Web Push). В уведомлении нет имени и телефона клиента
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

/// Служебные настройки, которые сервер создаёт сам (например, ключи для уведомлений)
model AppSetting {
  key   String @id
  value String
}

model Session {
  id        String   @id // sha256 от токена из cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Мини-CRM рассылки (раздел 2.3)
model Lead {
  id          String     @id @default(cuid())
  businessId  String     @unique
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status      LeadStatus @default(new)
  channel     String?
  contact     String?
  notes       String?
  firstMessage String? // сообщение с демо (после ответа «да») из таблицы при импорте, ссылка уже подставлена
  contactedAt DateTime?
  updatedAt   DateTime   @updatedAt
}

model Payment {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount      Int
  purpose     String
  periodFrom  DateTime?
  periodTo    DateTime?
  receiptSent Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([businessId])
}

/// Ограничение частоты: запись, вход. key — например «booking:ip:1.2.3.4»
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

/// Журнал действий без персональных данных клиентов (раздел 6.3, п. 8)
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  businessId String?
  action     String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}
