// Схема данных «Автослот». Раздел 5.4 плана.
// Все моменты времени хранятся в UTC. Часы работы и даты исключений — в местном времени сервиса.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  demo
  trial
  active
  suspended
  archived
}

enum Theme {
  tire // «Колесо» (до 14.10.2026 — «Тёмный», «Боковина»)
  plan // «Светлый», «План»
  taxi // «Чёрно-белый», «Такси»
  scan // «Сканер»
  dots // «Частицы»
}

enum BookingSource {
  site
  owner
}

enum BookingStatus {
  active
  cancelled
  no_show
  done
}

enum BlockScope {
  all
  one_post
}

enum Role {
  owner
  admin
}

enum LeadStatus {
  new
  asked // спросили, можно ли прислать демо (ст. 15 152-ФЗ), ждём ответа
  demo_sent
  replied
  interested
  trial
  paid
  refused
}

model Business {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  city     String @default("Пермь")
  timezone String @default("Asia/Yekaterinburg")

  address       String
  addressNote   String?
  phone         String
  yandexMapsUrl String?
  twoGisUrl     String?
  rating        Decimal? @db.Decimal(2, 1)
  reviewsYandex Int?
  reviews2gis   Int?

  headline      String?
  facts         Json? // [{ value: "2 поста", label: "можно приехать вдвоём" }]
  theme         Theme     @default(dots)
  accent        String    @default("#7c5cff")
  themeChosenAt DateTime? // владелец сам выбрал стиль в демо
  // Логотип загружает владелец в кабинете; сама картинка — в BusinessLogo, здесь время загрузки для адреса без кеша
  logoAt        DateTime?

  // Настройки расписания (раздел 4.1)
  posts       Int @default(1)
  /// Сколько постов отдано под запись с сайта (остальные — живая очередь и звонки, их в кабинет вносить не нужно)
  onlinePosts Int @default(1)
  /// Стенды развал-схождения, отдельно от постов: услуги с отметкой onStand записываются только на них, остальные — только на посты
  standPosts  Int @default(0)
  /// В форме записи на сайте обязателен госномер машины (просьба клиента: «марка, модель и госномер»)
  askPlate       Boolean @default(false)
  /// Комментарий к записи обязателен: что нужно сделать
  requireComment Boolean @default(false)
  slotStepMin Int @default(30)
  minLeadMin  Int @default(120)
  horizonDays Int @default(14)
  cancelHours Int @default(0) // за сколько часов до визита клиент ещё может отменить онлайн; 0 — до начала

  // Оператор персональных данных — сам автосервис (раздел 6.3)
  operatorName    String?
  operatorInn     String?
  // Уведомление сервиса в Роскомнадзор об обработке данных клиентов: когда подано и номер (отмечает администратор)
  rknFiledAt      DateTime?
  rknNumber       String?
  // Принятие оферты владельцем в кабинете (галочка при первом входе): когда и какая редакция
  offerAcceptedAt DateTime?
  offerVersion    String?
  // Утренняя сводка владельцу (push в 8:00 по времени сервиса): можно выключить в кабинете.
  // digestSentOn — местная дата последней сводки, чтобы при повторном запуске расписания не прислать вторую
  digestEnabled   Boolean   @default(true)
  digestSentOn    String?

  status        BusinessStatus @default(demo)
  demoExpiresAt DateTime?
  trialEndsAt   DateTime?
  paidUntil     DateTime?
  // Когда сайт приостановили (нет оплаты или вручную). Через 60 дней приостановки договор расторгнут (оферта, п. 4.2),
  // и в админке появляется напоминание удалить данные (п. 7.7). При возобновлении стирается
  suspendedAt   DateTime?
  customDomain  String?        @unique
  addonTelegram Boolean        @default(false)
  addonSms      Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services   Service[]
  hours      WorkingHours[]
  exceptions DayException[]
  bookings   Booking[]
  blocks     Block[]
  users      User[]
  lead       Lead?
  payments   Payment[]
  pushSubs   PushSubscription[]
  logo       BusinessLogo?
  demoViews  DemoView[]
  staff      Staff[]
  notes      CalendarNote[]
}

/// Сотрудник (у «Конкурента» один сотрудник на пост) или стенд развала: колонка в календаре кабинета со своим цветом.
/// Записи с сайта сами встают к первому свободному; владелец выбирает сам. Без сотрудников календарь показывает «Пост 1…N».
model Staff {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  color      String
  onStand    Boolean   @default(false)
  sortOrder  Int       @default(0)
  bookings   Booking[]
  notes      CalendarNote[]

  @@index([businessId, sortOrder])
}

/// Запись на весь день в календаре кабинета («108 до 17»): заметка без времени, посты не занимает
model CalendarNote {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  title      String
  /// Местные даты ГГГГ-ММ-ДД, конец включительно
  startDate  String
  endDate    String
  /// UID события из Google Календаря при переносе: повторный перенос не создаёт копий
  externalId String?
  createdAt  DateTime @default(now())

  @@unique([businessId, externalId])
  @@index([businessId, startDate])
  @@index([staffId])
}

/// Картинка логотипа отдельно от Business: сервис читается на каждой странице, а картинка нужна только сайту.
/// Хранится в базе, поэтому попадает в резервные копии вместе со всем остальным.
model BusinessLogo {
  businessId String   @id
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  data       Bytes
  mime       String
  updatedAt  DateTime @updatedAt
}

model Service {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     String
  name         String
  description  String?
  priceFrom    Int
  durationMin  Int
  isDiagnostic Boolean   @default(false)
  /// Делается на стенде развал-схождения (Business.standPosts), а не на обычном посту
  onStand      Boolean   @default(false)
  sortOrder    Int       @default(0)
  active       Boolean   @default(true)
  bookings     Booking[]

  @@index([businessId, sortOrder])
}

/// Часы работы по дню недели: 1 — понедельник … 7 — воскресенье. Минуты от полуночи по местному времени.
model WorkingHours {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday      Int
  closed       Boolean  @default(false)
  openMin      Int      @default(540)
  closeMin     Int      @default(1200)
  // Обед или другой ежедневный перерыв (минуты от полуночи). Пусто — без перерыва
  breakFromMin Int?
  breakToMin   Int?

  @@unique([businessId, weekday])
}

/// Особый день: праздник или изменённые часы. date — «YYYY-MM-DD» по местному времени.
model DayException {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       String
  closed     Boolean  @default(true)
  openMin    Int?
  closeMin   Int?

  @@unique([businessId, date])
}

model Booking {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName String
  priceFrom   Int?
  /// Занимает стенд развала, а не пост: копия Service.onStand на момент записи
  onStand     Boolean       @default(false)
  /// К какому сотруднику (колонке календаря) стоит запись
  staffId     String?
  staff       Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  /// Кто внёс запись в кабинете (у каждого сотрудника свой вход); у записей с сайта пусто
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// UID события из Google Календаря при переносе: повторный перенос не создаёт копий
  externalId  String?
  startAt     DateTime
  endAt       DateTime
  source      BookingSource
  status      BookingStatus @default(active)

  clientName  String?
  clientPhone String?
  car         String?
  comment     String?

  cancelToken String @unique

  // Согласие на обработку ПДн (раздел 6.3, п. 2) и отдельное согласие на рекламу (раздел 6.6)
  consentVersion   String?
  consentAt        DateTime?
  consentIp        String?
  marketingConsent Boolean   @default(false)

  createdAt   DateTime  @default(now())
  cancelledAt DateTime?
  cancelledBy String?

  @@index([businessId, startAt])
  @@index([businessId, status, startAt])
  // Удаление услуги обнуляет serviceId у её записей: без индекса это просмотр всех записей всех сервисов
  @@index([serviceId])
  @@index([staffId])
  @@index([createdById])
  @@unique([businessId, externalId])
}

model Block {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  startAt    DateTime
  endAt      DateTime
  scope      BlockScope @default(all)
  reason     String?
  createdAt  DateTime   @default(now())

  @@index([businessId, startAt])
}

model User {
  id           String             @id @default(cuid())
  phone        String             @unique
  passwordHash String
  role         Role               @default(owner)
  name         String?
  businessId   String?
  business     Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
  pushSubs     PushSubscription[]
  bookings     Booking[]
}

/// Подписка телефона или компьютера владельца на уведомления кабинета (Web Push). В уведомлении нет имени и телефона клиента
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

/// Служебные настройки, которые сервер создаёт сам (например, ключи для уведомлений)
model AppSetting {
  key   String @id
  value String
}

model Session {
  id        String   @id // sha256 от токена из cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Мини-CRM рассылки (раздел 2.3)
model Lead {
  id           String     @id @default(cuid())
  businessId   String     @unique
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status       LeadStatus @default(new)
  channel      String?
  contact      String?
  notes        String?
  firstMessage String? // сообщение с демо (после ответа «да») из таблицы при импорте, ссылка уже подставлена
  askVariant   Int? // какой вариант первого сообщения-вопроса отправили (QUESTION_NAMES в lib/outreach.ts), с 13 октября 2026
  contactedAt  DateTime?
  updatedAt    DateTime   @updatedAt
}

/// Владелец открыл демо по ссылке из сообщения (или переключил в нём стиль). Видно в админке: кто смотрел и сколько раз.
/// Без IP, cookie и других сведений об устройстве: только время и телефон это или компьютер.
model DemoView {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String // open — открыли демо, style — посмотрели другой стиль
  device     String // phone, desktop
  at         DateTime @default(now())

  @@index([businessId, at])
}

model Payment {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount      Int
  purpose     String
  periodFrom  DateTime?
  periodTo    DateTime?
  receiptSent Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([businessId])
}

/// Ограничение частоты: запись, вход. key — например «booking:ip:1.2.3.4»
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

/// Журнал действий без персональных данных клиентов (раздел 6.3, п. 8)
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  businessId String?
  action     String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}
